# Einmaliger Startzugang. Nach der Einrichtung steht das Konto im Ordner config.
DASHBOARD_AUTH='admin:DEIN_LANGES_PASSWORT'

# Nur für LAN-Zugriff oder Nginx Proxy Manager ausfüllen. Echte private IP einsetzen.
# SYNC_BIND_IP=192.168.1.20
# DASHBOARD_BIND_IP=192.168.1.20

# Auf dem Docker-Host eingehängter Backup-Ordner.
# BACKUP_DIR=/mnt/backup-server/anki

# Zeitzone der Logs und Vorgabe für einen neuen Backup-Zeitplan.
